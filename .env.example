# ---------------------------------------------------------------------------
# Zan — environment configuration
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Public URL of the deployed app (used in share links, QR codes and OG tags).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Panta API (server only) ------------------------------------------------
# Register at https://live-api.panta.market/api/v1/auth/register/ and mint a key
# with POST /account/keys/. pk_live_ = mainnet, pk_test_ = Panta sandbox fixtures.
PANTA_API_KEY=
PANTA_API_URL=https://live-api.panta.market/api/v1
# Comma-separated program IDs allowed in Panta-built transactions (both seen live).
PANTA_PROGRAM_IDS=6gM5afTQBq5VZCfgpGqcsqzfWd5maLSCKWtGjbEobZMp,4CQ4LWv7194V3Qe3iEYZq33cFPQbmKU3e1xVQkpTegLU

# --- Privy (login + embedded Solana wallets) --------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Solana -----------------------------------------------------------------
# Server RPC used to broadcast and confirm transactions (use a paid RPC such as Helius).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Public RPC the Privy wallet UI may use to display transaction details.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Mainnet USDC mint (Panta collateral).
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# --- Database ---------------------------------------------------------------
# Postgres connection string (Supabase, Neon, ...). Leave empty for a local
# embedded Postgres (PGlite) stored in .data/pglite — development only.
DATABASE_URL=
# Set to "false" to skip automatic migrations on first DB access.
AUTO_MIGRATE=true

# --- Compliance -------------------------------------------------------------
# ISO country codes where real-money trading and promotion are switched off
# (fans there can still make free calls). Leave empty to use the built-in list.
REAL_MONEY_BLOCKED_COUNTRIES=
# Country to assume when no geo header is present (local dev only, e.g. GH).
DEV_COUNTRY=
# Team/test wallets excluded from traction metrics and leaderboards.
EXCLUDED_WALLETS=

# --- Jobs -------------------------------------------------------------------
# Shared secret for /api/cron/sync (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Optional: AI market drafting -------------------------------------------
# Any chat-completions compatible endpoint that supports JSON responses.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
